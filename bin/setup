#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'

# We change the script's current working directory to the project root directory
# so that relative paths are resolved correctly regardless of where the script is run from
root_dir = File.expand_path('..', __dir__)
Dir.chdir(root_dir)

# Define the relative file paths
db_path = 'db/development.sqlite3'
schema_path = 'db/schema.sql'
seed_path = 'db/seed.sql'

# Define a helper method that accepts the command parts, e.g. "bundle", "install"
# These are then passed into the system method which then passes them as separate entries
# in an argv array straight to the OS process loader
def run_command(*args)
  success = system(*args)
  abort("Command failed: #{args.join(' ')}") unless success
end

# Define a helper method that formats the short database summary at the end of the script
def format_db_summary(table_name, num_rows)
  table_name_clean = table_name.tr('_', ' ')
  singular = if table_name_clean.end_with?('ies')
               "#{table_name_clean.sub(/ies\z/, '')}y"
             else
               table_name_clean.sub(/s\z/, '')
             end
  plural = table_name_clean
  label = num_rows == 1 ? singular : plural
  " #{num_rows} #{label}"
end

# Check whether schema and seed exist before running the command
abort("Error: Schema file not found at #{schema_path}") unless File.file?(schema_path)
abort("Error: Seed file not found at #{seed_path}") unless File.file?(seed_path)

puts 'Installing Ruby gems...'
run_command('bundle', 'install')
puts 'Ruby gems installed successfully'

# We require the gems here and not at the top of the file, because they only exist after 'bundle install' has run
require 'bundler/setup'
require 'sqlite3'

# We create the directory (along with any nested directories) where the database file should live
FileUtils.mkdir_p(File.dirname(db_path))
# We delete the database file if it already exists and start with a fresh setup
FileUtils.rm_f(db_path)

db = SQLite3::Database.new(db_path)

begin
  db.execute('PRAGMA foreign_keys = ON;')
  db.execute_batch(File.read(schema_path))
  db.execute_batch(File.read(seed_path))
rescue SQLite3::Exception => e
  abort("Database setup error: #{e.message}")
end

puts "Database rebuilt: #{db_path}"

# Query that reads all the table names in the database
query = "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%'"

# Printing a short summary with each table name (if it contains some data) and number of rows
begin
  tables = db.execute(query).flatten
  tables.each do |table|
    rows_count = db.get_first_value(%(SELECT COUNT(*) FROM "#{table}"))
    puts format_db_summary(table, rows_count) if rows_count.positive?
  end
rescue SQLite3::Exception => e
  warn "Failed to generate short database summary: #{e.message}"
ensure
  db&.close
end
